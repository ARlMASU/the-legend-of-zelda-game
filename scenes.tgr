// TileBloc : solid tile, non-collidable, costToTarget and costFromStart are used for pathfindings
public class TileBloc extends Bloc{
	private int posX;
	private int posY;
	private boolean isWalkable;
	private double costToTarget = Double.POSITIVE_INFINITY;
    private double costFromStart = Double.POSITIVE_INFINITY;
    private TilePos parentTilePos = null;
	
	public TileBloc(int x, int y){
		super();
		
		this.posX = x;
		this.posY = y;
		
		setObjTilePos(this, x, y);
	}
	
	public void changeTileImage(int newTileImageIndex){
		if(newTileImageIndex == 0){
			setObjTilePos(this, -1, -1);
			this.isWalkable = true;
		}else {
			this.isWalkable = false;
			this.chargerImage("tile_" + newTileImageIndex + ".png");
			setObjTilePos(this, this.posX, this.posY);
			link.ajouterBloc(this);
		}
	}
	
	public int getPosX(){
		return this.posX;
	}
	
	public int getPosY(){
		return this.posY;
	}
	
	public boolean getIsWalkable(){
		return this.isWalkable;
	}
	
	public void setIsWalkable(boolean newValue){
		this.isWalkable = newValue;
	}
	
	public double getCostToTarget(){
		return this.costToTarget;
	}
	
	public void setCostToTarget(double newCostToTarget){
		this.costToTarget = newCostToTarget;
	}
	
	public double getCostFromStart(){
		return this.costFromStart;
	}
	
	public void setCostFromStart(double newCostFromStart){
		this.costFromStart = newCostFromStart;
	}
	
	public TileBloc getParentTile(){
		if(this.parentTilePos == null) return null;
		return blocTiles[this.parentTilePos.x][this.parentTilePos.y];
	}
	
	public void setParentTile(TileBloc newParent){
		if(newParent == null){
			this.parentTilePos = null;
		}else {
			this.parentTilePos = new TilePos(newParent.getPosX(), newParent.getPosY());
		}
	}
}

// Scene : class for the 128 scenes of the game, containing infos for each scenes
public class Scene{
	private static int currentId = 1;
	private int sceneId;
	private String bgColor;
	private int sceneChangeUp;
	private int sceneChangeRight;
	private int sceneChangeDown;
	private int sceneChangeLeft;
	
	public Scene(int sChUp, int sChRight, int sChDown, int sChLeft){
		this.sceneId = currentId++;
		this.bgColor = "beige";
		this.sceneChangeUp = sChUp;
		this.sceneChangeRight = sChRight;
		this.sceneChangeDown = sChDown;
		this.sceneChangeLeft = sChLeft;
	}
	
	public Scene(int sChUp, int sChRight, int sChDown, int sChLeft, String bgC){
		this.sceneId = currentId++;
		this.bgColor = bgC;
		this.sceneChangeUp = sChUp;
		this.sceneChangeRight = sChRight;
		this.sceneChangeDown = sChDown;
		this.sceneChangeLeft = sChLeft;
	}
	
	public int getId(){
		return this.sceneId;
	}
	
	public int getSceneChange(String direction){
		switch(direction){
			case "up":
				return this.sceneChangeUp;
			case "right" :
				return this.sceneChangeRight;
			case "down":
				return this.sceneChangeDown;
			case "left":
				return this.sceneChangeLeft;
			default:
				tangara.écrire("unvalid sceneChangeDirection");
				return -1;
		}
	}
	
	public String getBgColor(){
		return this.bgColor;
	}
}

//=============//
//  FUNCTIONS  //
//=============//

// handleTilesDisplay() : displays every TileBloc and TileAnim of the currentScene
public void handleTilesDisplay(int sceneId){
	String selectedFgTilemap = foregroundTilemaps[sceneId - 1];
	
	for(int y = 0; y < 11; y++){
		for(int x = 0; x < 16; x++){
			int fgTileImageIndex = alphabet.indexOf(selectedFgTilemap.charAt(y * 16 + x));
			blocTiles[x][y].changeTileImage(fgTileImageIndex);
		}
	}
	
	String selectedMgTilemap = middlegroundTilemaps[sceneId - 1];
	
	int currentCharacterPos = 0; // equivalent to a pointer in the String selectedMgTileMap
	// E.g. when the currentCharacterPos = 0,
	//  			"777777000..."
	// it points at: ^ -> the first character of the String
	
	if(selectedMgTilemap.length() == 0){
		for (TileAnim[] rowOfTiles : animTiles) {
			for (TileAnim tile : rowOfTiles) {
				tile.changeTileImage(0);
			}
		}
	}else {
		for(int y = 0; y < 11; y++){
			if(alphabet.indexOf(selectedMgTilemap.charAt(currentCharacterPos)) == 7){ // meaning we have an empty row
				for(int x = 0; x < 16; x++){
					animTiles[x][y].changeTileImage(0);
				}
				currentCharacterPos++;
			}else{
				for(int x = 0; x < 16; x++){
					int mgTileImageIndex = alphabet.indexOf(selectedMgTilemap.charAt(currentCharacterPos + x));
					animTiles[x][y].changeTileImage(mgTileImageIndex);
				}
				currentCharacterPos += 16;
			}
		}
	}
}

//=============//
//  INSTANCES  //
//=============//

// blocTiles : array containing every TileBloc of the game, 16 = width of game's grid, 11 = height
TileBloc[][] blocTiles = new TileBloc[16][11];

for(int y = 0; y < 11; y++){
	for(int x = 0; x < 16; x++){
		blocTiles[x][y] = new TileBloc(x, y);
	}
}

