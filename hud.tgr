Animation gameOver = new Animation("game_over.png");
setObjTilePos(gameOver, 0, 0);
gameOver.cacher();

Animation hudMenu = new Animation("hud_menu.png"); // background of the hud

public Minuteur rupeesCounterAnimTimer = new Minuteur();
rupeesCounterAnimTimer.définirDélai(12);
rupeesCounterAnimTimer.ajouterCommande("rupeesCounterAnimStep()");

RupeeCounter rupeeCounter = new RupeeCounter();

displayedRupees = link.getRupees();
targetRupees = displayedRupees;
rupeeCounter.setValue(displayedRupees);

HudItem[] hudItems = {
	 new HudItem("sword", 19, 3),
	 new HudItem("bow", 16, 3),
	 new HudItem("bomb", 16, 3) // bow and bomb aren't used yet
}

ArrayList heartContainers = new ArrayList();
for(int i = 0; i < 3; i++){
	heartContainers.add(new HeartContainer());
}